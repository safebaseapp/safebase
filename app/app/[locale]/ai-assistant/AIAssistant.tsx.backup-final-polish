        setError(
          isTurkish
            ? "Lütfen bir HSE sorusu girin."
            : "Please enter an HSE question.",
        );
      }

      return;
    }

    const userMessage: Message = {
      id: createMessageId(),
      role: "user",
      content: cleanQuestion,
    };

