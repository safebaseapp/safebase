<head>
<meta charset="utf-8"/>
<title>SERNEM HSE Report</title>

<style>
  * { box-sizing: border-box; }

  body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #102033;
    background: #fff;
  }

  .page {
    padding: 38px 42px;
  }

  .header {
    background: #06152b;
    color: white;
    padding: 28px;
    border-radius: 18px;
  }

  .brand {
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 3px;
  }

  .subtitle {
    color: #72b8ff;
    margin-top: 5px;
    font-size: 12px;
    letter-spacing: 2px;
  }

  .period {
    margin-top: 18px;
    font-size: 14px;
    color: #c4d3e5;
  }

  .grid {
    margin-top: 24px;
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 12px;
  }

  .card {
    border: 1px solid #d9e4ef;
    border-radius: 14px;
    padding: 18px;
  }

  .card small {
    display: block;
    color: #64748b;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 1.2px;
  }

  .card strong {
    display: block;
    margin-top: 8px;
    font-size: 27px;
  }

  h2 {
    margin-top: 30px;
    font-size: 17px;
  }

  .summary {
    background: #eef6ff;
    border-left: 5px solid #2563eb;
