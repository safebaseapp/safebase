                    value={category}
                  >
                    {category}
                  </option>
                ))}
              </select>

              <input
                placeholder={
                  isTurkish
                    ? "Gözlem başlığı"
                    : "Observation title"
                }
                value={form.title}
                onChange={(e) =>
                  setForm({
                    ...form,
                    title: e.target.value,
                  })
                }
                className="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm"
              />

              <textarea
                rows={3}
                placeholder={
                  isTurkish
                    ? "Açıklama"
                    : "Description"
                }
                value={form.description}
                onChange={(e) =>
                  setForm({
                    ...form,
                    description:
                      e.target.value,
                  })
                }
                className="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm"
              />

              <textarea
                rows={2}
                placeholder={
                  isTurkish
                    ? "Alınacak aksiyon"
                    : "Corrective action"
                }
                value={form.corrective_action}
                onChange={(e) =>
                  setForm({
                    ...form,
                    corrective_action:
                      e.target.value,
                  })
                }
                className="w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm"
              />

              <div className="grid grid-cols-2 gap-3">
                <input
                  placeholder={
                    isTurkish
                      ? "Sorumlu kişi"
                      : "Responsible"
                  }
                  value={form.responsible_person}
                  onChange={(e) =>
                    setForm({
                      ...form,
                      responsible_person:
                        e.target.value,
                    })
                  }
                  className="rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm"
                />

                <input
                  type="date"
                  value={form.target_date}
                  onChange={(e) =>
                    setForm({
                      ...form,
                      target_date:
                        e.target.value,
                    })
                  }
                  className="rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm"
                />
              </div>

              <button
                type="button"
                onClick={saveObservation}
                disabled={saving}
                className="w-full rounded-xl bg-blue-600 px-4 py-3 font-black transition hover:bg-blue-500 disabled:opacity-50"
              >
                {saving
                  ? isTurkish
                    ? "Kaydediliyor..."
                    : "Saving..."
                  : isTurkish
                    ? "Gözlemi Kaydet"
                    : "Save Observation"}
              </button>

              {message && (
                <p className="text-xs text-slate-400">
                  {message}
                </p>
              )}
            </div>
          </section>

          {/* KPI CENTER */}
          <section className="rounded-[26px] border border-slate-800 bg-slate-900/80 p-5">
            <p className="text-xs font-black uppercase tracking-[0.18em] text-blue-400">
              02
            </p>

            <h2 className="mt-2 text-xl font-black">
              KPI Dashboard
            </h2>

            <div className="mt-5 grid gap-4 md:grid-cols-2">

              {/* DONUT */}
              <div className="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
                <p className="text-sm font-black">
                  {isTurkish
                    ? "Gözlem Dağılımı"
                    : "Observation Distribution"}
                </p>

                <div className="mt-5 flex items-center gap-6">
                  <div
                    className="relative h-32 w-32 shrink-0 rounded-full"
                    style={{
                      background:
                        stats.total === 0
                          ? "#1e293b"
                          : `conic-gradient(
                              #10b981 0deg ${donut.positiveDeg}deg,
                              #f59e0b ${donut.positiveDeg}deg ${donut.actDeg}deg,
                              #ef4444 ${donut.actDeg}deg 360deg
                            )`,
                    }}
                  >
                    <div className="absolute inset-[20px] flex flex-col items-center justify-center rounded-full bg-[#07111f]">
                      <span className="text-2xl font-black">
                        {stats.total}
                      </span>

                      <span className="text-[9px] uppercase tracking-wider text-slate-500">
                        {isTurkish
                          ? "Gözlem"
                          : "Total"}
                      </span>
                    </div>
                  </div>

                  <div className="space-y-3 text-xs">
                    <p className="flex items-center gap-2">
                      <span className="h-2.5 w-2.5 rounded-full bg-emerald-500" />
                      Positive
                      <b className="ml-auto">
                        {stats.positive}
                      </b>
                    </p>

                    <p className="flex items-center gap-2">
                      <span className="h-2.5 w-2.5 rounded-full bg-amber-500" />
                      Unsafe Act
                      <b className="ml-auto">
                        {stats.unsafeAct}
                      </b>
                    </p>

                    <p className="flex items-center gap-2">
                      <span className="h-2.5 w-2.5 rounded-full bg-red-500" />
                      Unsafe Condition
                      <b className="ml-auto">
                        {stats.unsafeCondition}
                      </b>
                    </p>
                  </div>
                </div>
              </div>

              {/* PERFORMANCE */}
              <div className="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
                <p className="text-sm font-black">
                  {isTurkish
                    ? "Performans Seviyesi"
                    : "Performance Level"}
                </p>

                <div className="mt-5 flex items-center gap-5">
                  <div
                    className={`flex h-24 w-24 shrink-0 items-center justify-center rounded-full border text-4xl font-black ${
                      stats.grade === "A"
                        ? "border-emerald-400/40 bg-emerald-500/10 text-emerald-300"
                        : stats.grade === "B"
                          ? "border-lime-400/40 bg-lime-500/10 text-lime-300"
                          : stats.grade === "C"
                            ? "border-amber-400/40 bg-amber-500/10 text-amber-300"
                            : "border-red-400/40 bg-red-500/10 text-red-300"
                    }`}
                  >
                    {stats.grade}
                  </div>

                  <div>
                    <p className="text-xl font-black">
                      {gradeText}
                    </p>

                    <p className="mt-1 text-sm text-slate-500">
                      Score {stats.score}/100
                    </p>

                    <div className="mt-3 space-y-1 text-[11px] text-slate-500">
                      <p>
                        High open:{" "}
                        {stats.highOpen}
                      </p>

                      <p>
                        Critical open:{" "}
                        {stats.criticalOpen}
                      </p>

                      <p>
                        Overdue:{" "}
                        {stats.overdue}
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              {/* MONTHLY TREND */}
              <div className="rounded-2xl border border-slate-800 bg-slate-950/60 p-5 md:col-span-2">
                <div className="flex items-center justify-between">
                  <p className="text-sm font-black">
                    {isTurkish
                      ? "6 Aylık Trend"
                      : "6-Month Trend"}
                  </p>

                  <div className="flex gap-3 text-[10px] text-slate-500">
                    <span>
                      <b className="text-blue-400">
                        ●
                      </b>{" "}
                      Total
                    </span>

                    <span>
                      <b className="text-emerald-400">
                        ●
                      </b>{" "}
                      Positive
                    </span>

                    <span>
                      <b className="text-red-400">
                        ●
                      </b>{" "}
                      Unsafe
                    </span>
                  </div>
                </div>

                <div className="mt-6 flex h-44 items-end gap-4 border-b border-slate-800 px-2">
                  {monthlyTrend.map((item) => (
                    <div
                      key={item.key}
                      className="flex min-w-0 flex-1 flex-col items-center justify-end"
                    >
                      <div className="flex h-32 items-end gap-1">
                        <div
                          className="w-3 rounded-t bg-blue-500"
                          style={{
                            height: `${Math.max(
                              item.total === 0
                                ? 0
                                : 7,
                              (item.total /
                                maxTrend) *
                                100,
                            )}%`,
                          }}
                        />

                        <div
                          className="w-3 rounded-t bg-emerald-500"
                          style={{
                            height: `${Math.max(
                              item.positive === 0
                                ? 0
                                : 7,
                              (item.positive /
                                maxTrend) *
                                100,
                            )}%`,
                          }}
                        />

                        <div
                          className="w-3 rounded-t bg-red-500"
                          style={{
                            height: `${Math.max(
                              item.unsafe === 0
                                ? 0
                                : 7,
                              (item.unsafe /
                                maxTrend) *
                                100,
                            )}%`,
                          }}
                        />
                      </div>

                      <span className="mt-3 text-[10px] font-bold uppercase text-slate-500">
                        {item.label}
                      </span>
                    </div>
                  ))}
                </div>
              </div>

              {/* ACTION RATE */}
              <div className="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
                <p className="text-sm font-black">
                  {isTurkish
                    ? "Aksiyon Durumu"
                    : "Action Status"}
                </p>

                <div className="mt-5">
                  <div className="flex items-end justify-between">
                    <div>
                      <p className="text-4xl font-black text-emerald-400">
                        {stats.closureRate}%
                      </p>

                      <p className="mt-1 text-xs text-slate-500">
                        {isTurkish
                          ? "Kapanma oranı"
                          : "Closure rate"}
                      </p>
                    </div>

                    <div className="space-y-1 text-right text-xs">
                      <p className="text-blue-300">
                        Open {stats.open}
                      </p>

                      <p className="text-red-300">
                        Overdue{" "}
                        {stats.overdue}
                      </p>

                      <p className="text-emerald-300">
                        Closed{" "}
                        {stats.closed}
                      </p>
                    </div>
                  </div>

                  <div className="mt-5 h-2 overflow-hidden rounded-full bg-slate-800">
                    <div
                      className="h-full rounded-full bg-emerald-500 transition-all"
                      style={{
                        width: `${stats.closureRate}%`,
                      }}
                    />
                  </div>
                </div>
              </div>

              {/* CATEGORIES */}
              <div className="rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
                <p className="text-sm font-black">
                  {isTurkish
                    ? "En Çok Görülen Kategoriler"
                    : "Top Categories"}
                </p>

                <div className="mt-4 space-y-3">
                  {categoryData.length === 0 && (
                    <p className="py-6 text-center text-xs text-slate-500">
                      No data
                    </p>
                  )}

                  {categoryData.map((item) => (
                    <div key={item.name}>
                      <div className="mb-1.5 flex items-center justify-between text-[11px]">
                        <span className="truncate text-slate-400">
                          {item.name}
                        </span>

                        <b className="text-slate-300">
                          {item.percentage}%
                        </b>
                      </div>

                      <div className="h-1.5 overflow-hidden rounded-full bg-slate-800">
                        <div
                          className="h-full rounded-full bg-blue-500"
                          style={{
                            width: `${item.percentage}%`,
                          }}
                        />
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </div>

            {/* RECENT */}
            <div className="mt-4 rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
              <p className="text-sm font-black">
                {isTurkish
                  ? "Son Gözlemler"
                  : "Recent Observations"}
              </p>

              <div className="mt-4 grid gap-3 lg:grid-cols-2">
                {filteredObservations
                  .slice(0, 6)
                  .map((item) => (
                    <article
                      key={item.id}
                      className="rounded-xl border border-slate-800 bg-slate-900/65 p-4"
                    >
                      <div className="flex items-start justify-between gap-4">
                        <div className="min-w-0">
                          <p className="truncate font-bold">
                            {item.title}
                          </p>

                          <p className="mt-1 text-xs text-slate-500">
                            {item.company_name ||
                              "—"}{" "}
                            •{" "}
                            {item.project_name ||
                              "—"}
                          </p>

                          <p className="mt-2 text-[11px] text-slate-600">
                            {item.category}
                          </p>
                        </div>

                        <span className="rounded-full border border-slate-700 px-2 py-1 text-[10px] font-black uppercase text-slate-300">
                          {item.risk_level}
                        </span>
                      </div>
                    </article>
                  ))}
              </div>
            </div>
          </section>

          {/* ACTION TRACKING */}
          <aside className="rounded-[26px] border border-slate-800 bg-slate-900/80 p-5">
            <p className="text-xs font-black uppercase tracking-[0.18em] text-blue-400">
              03
            </p>

            <h2 className="mt-2 text-xl font-black">
              {isTurkish
                ? "Aksiyon Takibi"
                : "Action Tracking"}
            </h2>

            <div className="mt-5 grid grid-cols-3 gap-2">
              <button
                type="button"
                onClick={() =>
                  setActionTab("open")
                }
                className={`rounded-xl p-3 text-center text-xs font-black ${
                  actionTab === "open"
                    ? "bg-blue-600 text-white"
                    : "border border-blue-500/20 bg-blue-500/5 text-blue-300"
                }`}
              >
                {isTurkish ? "Açık" : "Open"}

                <div className="mt-1 text-xl">
                  {stats.open}
                </div>
              </button>

              <button
                type="button"
                onClick={() =>
                  setActionTab("overdue")
                }
                className={`rounded-xl p-3 text-center text-xs font-black ${
                  actionTab === "overdue"
                    ? "bg-red-600 text-white"
                    : "border border-red-500/25 bg-red-500/5 text-red-300"
                }`}
              >
                {isTurkish
                  ? "Gecikmiş"
                  : "Overdue"}

                <div className="mt-1 text-xl">
                  {stats.overdue}
                </div>
              </button>

              <button
                type="button"
                onClick={() =>
                  setActionTab("closed")
                }
                className={`rounded-xl p-3 text-center text-xs font-black ${
                  actionTab === "closed"
                    ? "bg-emerald-600 text-white"
                    : "border border-emerald-500/25 bg-emerald-500/5 text-emerald-300"
                }`}
              >
                {isTurkish
                  ? "Kapalı"
                  : "Closed"}

                <div className="mt-1 text-xl">
                  {stats.closed}
                </div>
              </button>
            </div>

            <div className="mt-5 max-h-[860px] space-y-3 overflow-y-auto pr-1">
              {visibleActions.length === 0 && (
                <div className="rounded-2xl border border-dashed border-slate-700 px-4 py-10 text-center text-sm text-slate-500">
                  {isTurkish
                    ? "Bu durumda aksiyon bulunmuyor."
                    : "No actions in this status."}
                </div>
              )}

              {visibleActions.map((item) => (
                <article
                  key={item.id}
                  className={`rounded-2xl border p-4 ${
                    isOverdue(item)
                      ? "border-red-500/30 bg-red-500/[0.04]"
                      : "border-slate-800 bg-slate-950/60"
                  }`}
                >
                  <div className="flex items-start justify-between gap-3">
                    <div className="min-w-0">
                      <p className="font-bold">
                        {item.corrective_action ||
                          item.title}
                      </p>

                      <p className="mt-2 text-xs uppercase tracking-wide text-slate-500">
                        {item.responsible_person ||
                          (isTurkish
                            ? "Sorumlu atanmadı"
                            : "Unassigned")}
                      </p>

                      {item.target_date && (
                        <p
                          className={`mt-1 text-xs ${
                            isOverdue(item)
                              ? "font-bold text-red-300"
                              : "text-slate-500"
                          }`}
                        >
                          {isTurkish
                            ? "Hedef:"
                            : "Due:"}{" "}
                          {item.target_date}
                        </p>
                      )}
                    </div>

                    <span
                      className={`rounded-full px-2 py-1 text-[10px] font-black uppercase ${
                        item.risk_level ===
                        "critical"
                          ? "bg-red-500/20 text-red-300"
                          : item.risk_level ===
                              "high"
                            ? "bg-orange-500/15 text-orange-300"
                            : item.risk_level ===
                                "medium"
                              ? "bg-amber-500/15 text-amber-300"
                              : "bg-emerald-500/10 text-emerald-300"
                      }`}
                    >
                      {item.risk_level}
                    </span>
                  </div>

                  {item.status !== "closed" && (
                    <button
                      type="button"
                      disabled={
                        closingId === item.id
                      }
                      onClick={() =>
                        closeAction(item)
                      }
                      className="mt-4 w-full rounded-xl border border-emerald-400/25 bg-emerald-500/10 px-3 py-2.5 text-xs font-black text-emerald-300 transition hover:bg-emerald-500/20 disabled:opacity-50"
                    >
                      {closingId === item.id
                        ? isTurkish
                          ? "Kapatılıyor..."
                          : "Closing..."
                        : isTurkish
                          ? "✓ Aksiyonu Kapat"
                          : "✓ Close Action"}
                    </button>
                  )}
                </article>
              ))}
            </div>
          </aside>
        </div>
      </div>
    </main>
  );
}
