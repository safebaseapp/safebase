import { notFound } from "next/navigation";
import PosterMaster from "@/components/posters/PosterMaster";
import { workingAtHeightPoster } from "@/lib/posters-v2/working-at-height";

type Props = {
  params: Promise<{
    locale: string;
  }>;
};

export default async function PosterLabPage({
  params,
}: Props) {
  const { locale } = await params;

  if (locale !== "tr" && locale !== "en") {
    notFound();
  }

  return (
    <main className="min-h-screen overflow-auto bg-slate-200 px-6 py-10">
      <div className="mb-6 text-center print:hidden">
        <h1 className="text-2xl font-black text-slate-950">
          SafeBase Poster Motoru V2
        </h1>

        <p className="mt-2 text-sm font-semibold text-slate-600">
          Mevcut poster sisteminden tamamen bağımsız test alanı
        </p>
      </div>

      <PosterMaster
        locale={locale}
        poster={workingAtHeightPoster}
      />
    </main>
  );
}
