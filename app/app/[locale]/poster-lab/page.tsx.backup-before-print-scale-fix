import { notFound } from "next/navigation";
import PosterMaster from "@/components/posters-v4/PosterMasterV4";
import PosterFormatToolbar from "@/components/posters-v4/PosterFormatToolbar";
import { workingAtHeightPoster } from "@/lib/posters-v2/working-at-height";

type Props = {
  params: Promise<{
    locale: string;
  }>;
  searchParams: Promise<{
    size?: string;
  }>;
};

export default async function PosterLabPage({
  params,
  searchParams,
}: Props) {
  const { locale } = await params;
  const { size } = await searchParams;

  if (locale !== "tr" && locale !== "en") {
    notFound();
  }

  const posterSize = size === "a4" ? "a4" : "a3";
  const isA4 = posterSize === "a4";
  const isTurkish = locale === "tr";

  return (
    <>
      <style
        dangerouslySetInnerHTML={{
          __html: `
            @page {
              size: ${isA4 ? "A4" : "A3"} portrait;
              margin: 0;
            }

            @media print {
              html,
              body {
                width: ${isA4 ? "210mm" : "297mm"};
                height: ${isA4 ? "297mm" : "420mm"};
                margin: 0 !important;
                padding: 0 !important;
                background: white !important;
                overflow: hidden !important;
              }

              body * {
                visibility: hidden;
              }

              #poster-print-area,
              #poster-print-area * {
                visibility: visible;
              }

              #poster-preview {
                display: none !important;
              }

              #poster-print-area {
                position: absolute;
                left: 0;
                top: 0;
                width: ${isA4 ? "210mm" : "297mm"};
                height: ${isA4 ? "297mm" : "420mm"};
                margin: 0;
                padding: 0;
                overflow: hidden;
                background: white;
              }

              #poster-print-area #safebase-poster {
                position: absolute;
                left: 0;
                top: 0;
                margin: 0 !important;
                box-shadow: none !important;
                transform-origin: top left;
                ${
                  isA4
                    ? `
                      width: 297mm !important;
                      height: 420mm !important;
                      transform: scale(0.7070707);
                    `
                    : `
                      width: 297mm !important;
                      height: 420mm !important;
                      transform: none;
                    `
                }
              }
            }
          `,
        }}
      />

      <main className="min-h-screen bg-slate-200 px-5 py-10">
        <div
          id="poster-preview"
          className="mx-auto mb-8 max-w-5xl rounded-[28px] border border-slate-300 bg-white p-6 shadow-xl"
        >
          <div className="text-center">
            <p className="text-xs font-black uppercase tracking-[0.2em] text-emerald-600">
              SafeBase Poster Engine V4
            </p>

            <h1 className="mt-3 text-3xl font-black text-slate-950">
              {isTurkish
                ? "Profesyonel Poster İndirme"
                : "Professional Poster Download"}
            </h1>

            <p className="mt-3 text-sm font-semibold text-slate-600">
              {isTurkish
                ? "Boyutu seçin. Açılan yazdırma ekranında hedef olarak “PDF olarak kaydet” seçeneğini kullanın."
                : "Select a size. In the print dialog, choose “Save as PDF” as the destination."}
            </p>

            <p className="mt-2 text-xs font-bold text-slate-500">
              {isTurkish ? "Seçili boyut" : "Selected size"}:{" "}
              <span className="font-black text-slate-950">
                {posterSize.toUpperCase()}
              </span>
            </p>
          </div>

          <div className="mt-6">
            <PosterFormatToolbar locale={locale} />
          </div>
        </div>

        <div
          id="poster-print-area"
          className={`mx-auto overflow-hidden bg-white shadow-2xl ${
            isA4 ? "w-[794px]" : "w-[1123px]"
          }`}
        >
          <div
            className={
              isA4
                ? "h-[1123px] w-[794px] origin-top-left overflow-hidden"
                : ""
            }
          >
            <div
              className={
                isA4
                  ? "origin-top-left scale-[0.7070707]"
                  : ""
              }
            >
              <PosterMaster
                locale={locale}
                poster={workingAtHeightPoster}
              />
            </div>
          </div>
        </div>
      </main>
    </>
  );
}
