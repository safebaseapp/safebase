import SignIcon from "./SignIcon";
import type {
  SafetySign,
  SignLocale,
} from "@/lib/safety-signs/types";

type Props = {
  sign: SafetySign;
  locale: SignLocale;
  compact?: boolean;
};

export default function SignRenderer({
  sign,
  locale,
  compact = false,
}: Props) {
  const title = sign.title[locale];

  const titleSize = compact
    ? "text-[23px]"
    : "text-[43px]";

  const shell =
    "flex h-full w-full flex-col overflow-hidden rounded-[18px] border-[6px] border-white bg-white shadow-[0_20px_55px_rgba(0,0,0,0.34)]";

  if (sign.category === "mandatory") {
    return (
      <div className={shell}>
        <div className="flex min-h-0 flex-1 items-center justify-center bg-[#0754b8] p-[8%]">
          <div className="flex aspect-square w-[76%] items-center justify-center rounded-full bg-white p-[16%] text-[#0754b8]">
            <SignIcon icon={sign.icon} />
          </div>
        </div>

        <div className="flex min-h-[28%] items-center justify-center bg-white px-[7%] py-[5%] text-center">
          <h2
            className={`${titleSize} font-black uppercase leading-[1.05] tracking-[-0.025em] text-slate-950`}
          >
            {title}
          </h2>
        </div>
      </div>
    );
  }

  if (sign.category === "prohibition") {
    return (
      <div className={shell}>
        <div className="relative flex min-h-0 flex-1 items-center justify-center bg-white p-[8%]">
          <div className="relative flex aspect-square w-[76%] items-center justify-center rounded-full border-[18px] border-[#df111c] p-[17%] text-slate-950">
            <SignIcon icon={sign.icon} />

            <div className="absolute left-[2%] top-1/2 h-[18px] w-[96%] -translate-y-1/2 -rotate-45 rounded-full bg-[#df111c]" />
          </div>
        </div>

        <div className="flex min-h-[28%] items-center justify-center bg-[#df111c] px-[7%] py-[5%] text-center">
          <h2
            className={`${titleSize} font-black uppercase leading-[1.05] tracking-[-0.025em] text-white`}
          >
            {title}
          </h2>
        </div>
      </div>
    );
  }

  if (sign.category === "warning") {
    return (
      <div className={shell}>
        <div className="flex min-h-0 flex-1 items-center justify-center bg-[#ffd129] p-[6%]">
          <div
            className="relative flex h-[84%] w-[84%] items-center justify-center bg-slate-950"
            style={{
              clipPath:
                "polygon(50% 0%, 100% 100%, 0% 100%)",
            }}
          >
            <div
              className="absolute inset-[7%] flex items-center justify-center bg-[#ffd129]"
              style={{
                clipPath:
                  "polygon(50% 0%, 100% 100%, 0% 100%)",
              }}
            >
              <div className="mt-[18%] h-[43%] w-[43%] text-slate-950">
                <SignIcon icon={sign.icon} />
              </div>
            </div>
          </div>
        </div>

        <div className="flex min-h-[28%] items-center justify-center bg-slate-950 px-[7%] py-[5%] text-center">
          <h2
            className={`${titleSize} font-black uppercase leading-[1.05] tracking-[-0.025em] text-white`}
          >
            {title}
          </h2>
        </div>
      </div>
    );
  }

  if (sign.category === "fire") {
    return (
      <div className={shell}>
        <div className="flex min-h-0 flex-1 items-center justify-center bg-[#d71920] p-[17%] text-white">
          <SignIcon icon={sign.icon} />
        </div>

        <div className="flex min-h-[28%] items-center justify-center bg-white px-[7%] py-[5%] text-center">
          <h2
            className={`${titleSize} font-black uppercase leading-[1.05] tracking-[-0.025em] text-slate-950`}
          >
            {title}
          </h2>
        </div>
      </div>
    );
  }

  return (
    <div className={shell}>
      <div className="flex min-h-0 flex-1 items-center justify-center bg-[#008c5a] p-[17%] text-white">
        <SignIcon icon={sign.icon} />
      </div>

      <div className="flex min-h-[28%] items-center justify-center bg-white px-[7%] py-[5%] text-center">
        <h2
          className={`${titleSize} font-black uppercase leading-[1.05] tracking-[-0.025em] text-slate-950`}
        >
          {title}
        </h2>
      </div>
    </div>
  );
}
