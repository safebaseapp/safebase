import Icon from "@mdi/react";
import * as mdi from "@mdi/js";
import type { SignIcon } from "@/lib/safety-signs/types";

type Props = {
  icon: SignIcon;
};

const mdiSet = mdi as unknown as Record<string, string>;

function pickIcon(...names: string[]): string {
  for (const name of names) {
    const path = mdiSet[name];

    if (typeof path === "string" && path.length > 0) {
      return path;
    }
  }

  return mdiSet.mdiShieldAlert ?? "";
}

function MdiShape({
  path,
  className = "",
}: {
  path: string;
  className?: string;
}) {
  return (
    <Icon
      path={path}
      size="100%"
      color="currentColor"
      aria-hidden="true"
      className={className}
    />
  );
}

const paths = {
  helmet: pickIcon(
    "mdiHardHat",
    "mdiAccountHardHat",
    "mdiHelmetSafety",
  ),

  glasses: pickIcon(
